{
	"schemaVersion": 1,
	"id": "cinecorder",
	"version": "${version}",
	"name": "CineCorder",
	"description": "Record 3D animations from Blender onto cassettes and project them into the world with a real cinematic camera.",
	"authors": [
		"CineCorder contributors"
	],
	"contact": {
		"homepage": "https://example.invalid/cinecorder"
	},
	"license": "GPL-2.0-only",
	"icon": "assets/cinecorder/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.cinecorder.CineCorder"
		],
		"client": [
			"dev.cinecorder.client.CineCorderClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		{
			"config": "cinecorder.client.mixins.json",
			"environment": "client"
		}
	]
}
